// minihost_version.h -- GENERATED, do not edit.
//
// Generated by CMake from cmake/minihost_version.h.in. The values come from
// the single source of truth for the release version: the `version` field in
// pyproject.toml. Standalone CMake builds parse that file directly; wheel
// builds receive the same string as SKBUILD_PROJECT_VERSION. Both paths read
// the same line, so the Python package, the CLI binaries and the desktop app
// cannot disagree.
//
// This is the RELEASE version -- what a user means by "which minihost is
// this". It is deliberately distinct from MH_API_VERSION_* in minihost.h,
// which versions the C ABI and moves on its own schedule.

#ifndef MINIHOST_VERSION_H
#define MINIHOST_VERSION_H

#define MINIHOST_VERSION_MAJOR @MINIHOST_VERSION_MAJOR@
#define MINIHOST_VERSION_MINOR @MINIHOST_VERSION_MINOR@
#define MINIHOST_VERSION_PATCH @MINIHOST_VERSION_PATCH@

// Full release version as written in pyproject.toml, e.g. "0.7.1".
#define MINIHOST_VERSION "@MINIHOST_VERSION@"

#endif // MINIHOST_VERSION_H
